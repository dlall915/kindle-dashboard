export struct AlertItem {
    icon: string,
    text: string,
}

export component AppWindow inherits Window {
    background: white;

    in property <string> time-text: "--:--";
    in property <string> date-text: "";
    in property <string> weather-text: "";
    in property <string> battery-text: "";
    in property <string> weather-icon: "default";
    in property <bool> washer-done: false;
    // Plain lines for today's non-alert calendar events, e.g. "3:00 PM  Dentist".
    in property <[string]> today-items: [];
    // Calendar events matching a known keyword (see ALERT_KEYWORDS in
    // main.rs) - rendered as icon + message in the bottom section instead
    // of a plain today-items line.
    in property <[AlertItem]> today-alerts: [];

    function icon-for(key: string) -> image {
        return key == "sunny" ? @image-url("icons/sunny.svg") :
            key == "clear-night" ? @image-url("icons/clear-night.svg") :
            key == "partlycloudy" ? @image-url("icons/partlycloudy.svg") :
            key == "cloudy" ? @image-url("icons/cloudy.svg") :
            key == "rainy" ? @image-url("icons/rainy.svg") :
            key == "pouring" ? @image-url("icons/pouring.svg") :
            key == "lightning" ? @image-url("icons/lightning.svg") :
            key == "snowy" ? @image-url("icons/snowy.svg") :
            key == "fog" ? @image-url("icons/fog.svg") :
            key == "windy" ? @image-url("icons/windy.svg") :
            key == "hail" ? @image-url("icons/hail.svg") :
            @image-url("icons/default.svg");
    }

    // Separate namespace from icon-for: alert icons aren't weather icons,
    // and the two sets can grow independently. Add a new keyword in
    // main.rs's ALERT_KEYWORDS plus a case here to add another.
    function alert-icon-for(key: string) -> image {
        return key == "trash" ? @image-url("icons/trash.svg") :
            key == "recycling" ? @image-url("icons/recycling.svg") :
            key == "leaves" ? @image-url("icons/leaves.svg") :
            @image-url("icons/trash.svg");
    }

    // Shrinks the plain today-items list's font as the list grows, so a
    // busy day shows more real events before main.rs's safety cap has to
    // truncate the rest into a "+N more" line. Paired with a smaller line
    // spacing at the same breakpoints, since a smaller font needs less
    // room between lines too.
    function item-font-size(count: int) -> length {
        return count <= 3 ? 28px :
            count <= 6 ? 20px :
            16px;
    }
    function item-spacing(count: int) -> length {
        return count <= 3 ? 8px :
            count <= 6 ? 4px :
            2px;
    }

    // Shrinks each alert row (icon + message) as the alert count grows, the
    // same way item-font-size shrinks the plain event list. A fixed 128px
    // icon and 56px text only ever fit two alert rows in the space below
    // the top block - a third row's icon and text ran off the bottom edge
    // of the panel (confirmed on-device). More alert keywords are planned,
    // so this has to scale past today's three (trash, recycling, leaves).
    function alert-icon-size(count: int) -> length {
        return count <= 2 ? 128px :
            count <= 4 ? 96px :
            64px;
    }
    function alert-font-size(count: int) -> length {
        return count <= 2 ? 56px :
            count <= 4 ? 40px :
            28px;
    }
    function alert-spacing(count: int) -> length {
        return count <= 2 ? 12px :
            count <= 4 ? 8px :
            4px;
    }

    // --- Normal dashboard, no alerts today: time/date/weather/today-items
    // as one centered block, same as before alerts existed - no reason to
    // reserve bottom space for a section that has nothing in it.
    if !washer-done && today-alerts.length == 0: VerticalLayout {
        alignment: center;
        spacing: 16px;

        Text {
            text: time-text;
            font-size: 120px;
            font-weight: 600;
            color: black;
            horizontal-alignment: center;
        }
        Text {
            text: date-text;
            font-size: 40px;
            color: black;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Image {
                source: icon-for(weather-icon);
                width: 230px;
                height: 230px;
            }
        }
        Text {
            text: weather-text;
            font-size: 40px;
            color: black;
            horizontal-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            spacing: item-spacing(today-items.length);
            for item in today-items: Text {
                text: item;
                font-size: item-font-size(today-items.length);
                color: black;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }

    // --- Normal dashboard, alerts today: time/date/weather/today-items
    // pinned toward the top, a flexible gap, then today-alerts pinned
    // toward the bottom - gives the alerts their own dedicated room
    // instead of competing with the clock for center stage.
    if !washer-done && today-alerts.length > 0: VerticalLayout {
        VerticalLayout {
            alignment: start;
            padding-top: 60px;
            spacing: 16px;

            Text {
                text: time-text;
                font-size: 120px;
                font-weight: 600;
                color: black;
                horizontal-alignment: center;
            }
            Text {
                text: date-text;
                font-size: 40px;
                color: black;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                Image {
                    source: icon-for(weather-icon);
                    width: 230px;
                    height: 230px;
                }
            }
            Text {
                text: weather-text;
                font-size: 40px;
                color: black;
                horizontal-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                spacing: item-spacing(today-items.length);
                for item in today-items: Text {
                    text: item;
                    font-size: item-font-size(today-items.length);
                    color: black;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Flexible spacer - claims whatever height is left over, pushing
        // the alerts section below down to the bottom of the window.
        Rectangle {
            vertical-stretch: 1;
        }

        VerticalLayout {
            alignment: end;
            padding-bottom: 48px;
            spacing: alert-spacing(today-alerts.length);

            for alert in today-alerts: HorizontalLayout {
                alignment: center;
                spacing: 16px;
                Image {
                    source: alert-icon-for(alert.icon);
                    width: alert-icon-size(today-alerts.length);
                    height: alert-icon-size(today-alerts.length);
                }
                Text {
                    text: alert.text;
                    font-size: alert-font-size(today-alerts.length);
                    color: black;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // --- Full-screen washing-machine-done alert: nothing else shown ---
    if washer-done: VerticalLayout {
        alignment: center;
        spacing: 24px;

        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/washer_done.svg");
                width: 480px;
                height: 480px;
            }
        }
        Text {
            text: "Washing Machine Done!";
            font-size: 64px;
            font-weight: 600;
            color: black;
            horizontal-alignment: center;
        }
    }

    // --- Battery percentage, small, bottom-right corner, always visible ---
    Text {
        text: battery-text;
        font-size: 20px;
        color: black;
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
    }
}
